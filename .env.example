# Supabase project (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Postgres (Connect > ORMs > Prisma)
# Pooled connection (port 6543), used by the app at runtime
DATABASE_URL=
# Direct or session connection (port 5432), used by Prisma migrations
DIRECT_URL=

# Supabase service-role key (Project Settings > API). Server only; never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile site key (https://dash.cloudflare.com > Turnstile). Leave empty to disable
# the challenge locally. The matching SECRET key goes into Supabase: Authentication > Attack
# Protection > Enable Captcha protection > Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Content Security Policy: reports violations only until this is true. Watch the server log for
# "[csp]" lines after a release; when there are none, set it to true.
CSP_ENFORCE=false

# Spend limits (optional; defaults shown)
# AI requests allowed across all users per 24 hours
AI_DAILY_REQUEST_BUDGET=300
# Generations that may run at the same time, server-wide
AI_MAX_CONCURRENT=5
# Stored source files per user, in MB (Supabase free plan has 1 GB in total; Pro has 100 GB)
STORAGE_QUOTA_MB=100

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: models to use, in order of preference (comma separated). When one is over its
# quota, overloaded or retired, the next is used. Each model has its own daily allowance.
# GEMINI_NOTES_MODELS=gemini-flash-latest,gemini-3.5-flash,gemini-flash-lite-latest
# GEMINI_QUIZ_MODELS=gemini-flash-lite-latest,gemini-3.5-flash,gemini-flash-latest
# GEMINI_FLASHCARD_MODELS defaults to GEMINI_QUIZ_MODELS
